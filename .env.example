DISABLE_ESLINT_PLUGIN=true
GENERATE_SOURCEMAP=false
VITE_API_URL=https://agent-1o1-ai.test/api/v1
VITE_API_TIMEOUT=30000
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=agent-1o1-ai.test
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=https

# PostHog (leave the token empty to disable analytics)
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Error tracking (GlitchTip, Sentry-compatible; leave the DSN empty to disable)
# DSN from GlitchTip: Project > Settings > Client Keys (DSN). Use a project separate from the API.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
# Build only: set these in the host's build environment to upload source maps to GlitchTip.
# The release defaults to the commit being built (Netlify's COMMIT_REF).
# SENTRY_URL=https://app.glitchtip.com
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Build only: security headers are written to build/_headers for Netlify, with a CSP that
# allows the API, Reverb, PostHog and GlitchTip hosts set above. The CSP only reports
# violations (browser console) until this is set to "enforce".
# CSP_MODE=enforce

# Featurebase feature-request board (empty value hides the "Suggest a feature" links)
VITE_FEATUREBASE_URL=https://agent1o1.featurebase.app/
